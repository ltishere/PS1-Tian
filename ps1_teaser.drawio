        <mxCell id="disc" value="Dashed teal = proposed synthesis · dashed orange = anticipated, not obtained · all quantities are simulated under stipulated parameters" style="text;html=1;align=center;fontSize=9;fontStyle=2;fontColor=#5D6C79;" vertex="1" parent="1">
