<mxfile host="app.diagrams.net" version="24.0.0">
  <diagram id="ps1teaser" name="PS1 teaser">
    <mxGraphModel dx="1100" dy="480" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="440" math="0" shadow="0">
      <root>
        <mxCell id="0" />
