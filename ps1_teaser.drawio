        <mxCell id="syn" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#14877D;strokeWidth=2;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="130" y="212" width="920" height="140" as="geometry" />
        </mxCell>
        <mxCell id="syn1" value="Coaching-proof verification" style="text;html=1;align=center;fontSize=15;fontStyle=1;fontColor=#14877D;" vertex="1" parent="1">
          <mxGeometry x="140" y="220" width="900" height="22" as="geometry" />
        </mxCell>
        <mxCell id="syn2" value="A mechanism counts only if its decision is invariant to everything the reporting party says. Index friction to the counterparty's record, not to testimony." style="text;html=1;align=center;fontSize=11;fontColor=#16212B;" vertex="1" parent="1">
          <mxGeometry x="140" y="242" width="900" height="20" as="geometry" />
        </mxCell>
        <mxCell id="res1" value="Seeded sweep (obtained)&#10;record check: miss rate tracks 1 − p, max deviation 0.032" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7F8;strokeColor=#5D6C79;fontSize=10;fontColor=#16212B;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="148" y="268" width="288" height="44" as="geometry" />
        </mxCell>
        <mxCell id="res2" value="Ablation (obtained)&#10;script rate 1: miss = 1.000 with and without&#10;habituation — two separate failure channels" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7F8;strokeColor=#5D6C79;fontSize=10;fontColor=#16212B;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="446" y="268" width="288" height="44" as="geometry" />
        </mxCell>
        <mxCell id="res3" value="Anticipated (not obtained)&#10;on real payment data, fewer legitimate blocks&#10;at equal interception" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B26A00;dashed=1;fontSize=10;fontColor=#B26A00;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="744" y="268" width="288" height="44" as="geometry" />
