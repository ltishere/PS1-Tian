        <mxCell id="hdr" value="When the adversary writes the signal, what should verification be indexed to?" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#16212B;" vertex="1" parent="1">
          <mxGeometry x="90" y="8" width="1000" height="24" as="geometry" />
        </mxCell>

        <mxCell id="c1b" value="&lt;b style=&quot;color:#315EFB;font-size:14px&quot;&gt;Economics&lt;/b&gt;&#10;&lt;span style=&quot;color:#5D6C79;font-size:10px&quot;&gt;Ben-Porath, Dekel &amp; Lipman (2014)&lt;/span&gt;&#10;&#10;Verification is scarce; optimal allocation&#10;&lt;b&gt;concentrates&lt;/b&gt; checking on few cases&#10;&#10;&lt;span style=&quot;color:#14877D&quot;&gt;&lt;b&gt;I advance:&lt;/b&gt; to checks that are&#10;costly &lt;i&gt;and&lt;/i&gt; uninformative&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7F8;strokeColor=#315EFB;fontSize=11;fontColor=#16212B;verticalAlign=middle;arcSize=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="44" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c2b" value="&lt;b style=&quot;color:#315EFB;font-size:14px&quot;&gt;Computer science&lt;/b&gt;&#10;&lt;span style=&quot;color:#5D6C79;font-size:10px&quot;&gt;Conitzer &amp; Sandholm (2002)&lt;/span&gt;&#10;&#10;Mechanisms are &lt;b&gt;computed&lt;/b&gt; per setting;&#10;randomisation buys tractability&#10;&#10;&lt;span style=&quot;color:#14877D&quot;&gt;&lt;b&gt;I advance:&lt;/b&gt; recompute against&#10;an adversary that adapts each round&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7F8;strokeColor=#315EFB;fontSize=11;fontColor=#16212B;verticalAlign=middle;arcSize=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="425" y="44" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="c3b" value="&lt;b style=&quot;color:#315EFB;font-size:14px&quot;&gt;Behavioral science&lt;/b&gt;&#10;&lt;span style=&quot;color:#5D6C79;font-size:10px&quot;&gt;Anderson et al. (2016)&lt;/span&gt;&#10;&#10;Warnings &lt;b&gt;habituate&lt;/b&gt;; attention depletes&#10;with reuse, and the remedy is the interface&#10;&#10;&lt;span style=&quot;color:#14877D&quot;&gt;&lt;b&gt;I advance:&lt;/b&gt; the warning budget is&#10;a stock that depletes, not a price&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F7F8;strokeColor=#315EFB;fontSize=11;fontColor=#16212B;verticalAlign=middle;arcSize=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="44" width="330" height="130" as="geometry" />
        </mxCell>

        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#14877D;strokeWidth=1.5;endArrow=block;endFill=1;rounded=0;exitX=0.5;exitY=1;entryX=0.15;entryY=0;" edge="1" parent="1" source="c1b" target="syn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#14877D;strokeWidth=1.5;endArrow=block;endFill=1;rounded=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c2b" target="syn">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;strokeColor=#14877D;strokeWidth=1.5;endArrow=block;endFill=1;rounded=0;exitX=0.5;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="c3b" target="syn">
          <mxGeometry relative="1" as="geometry" />
